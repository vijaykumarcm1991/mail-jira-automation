# Mongo
MONGO_URI=mongodb://mongo:27017

# Email
EMAIL_ACCOUNT=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
IMAP_SERVER=imap.gmail.com

# Email via Microsoft 365 OAuth2 (app-only). Set EMAIL_AUTH_TYPE=oauth2 to use these
# instead of EMAIL_PASSWORD; IMAP_SERVER/SMTP_HOST/SMTP_PORT default to
# outlook.office365.com / smtp.office365.com / 587 when left empty.
EMAIL_AUTH_TYPE=basic
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# SMTP Details
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Timezone
TIMEZONE=Asia/Kolkata

# Auth
JWT_SECRET_KEY=change-this-long-random-secret
JWT_EXPIRE_MINUTES=480
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# JSM Cloud Details
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-api-token
JIRA_PROJECT_KEY=SUP
JIRA_ISSUE_TYPE=Incident

# Jira On-Prem Details
JIRA_ONPREM_URL=https://your-onprem-jira-url
JIRA_ONPREM_USER=your-username
JIRA_ONPREM_PASS=your-password
